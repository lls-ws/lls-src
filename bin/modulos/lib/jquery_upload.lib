#!/bin/bash
# Script to upload JS files on GitHub LLS-WS Repository
#
# Autor: Leandro Luiz
# email: lls.homeoffice@gmail.com

check_user()
{
	
	if [ "$EUID" -eq 0 ]; then
    
		echo "Root user not permited!"
		echo "Use: bash $0 $1"
		exit 1;
		
	fi
	
}

jquery_upload()
{
	
	check_user
	
	echo "Uploading JS Files to GitHub LLS-WS Repository"
	
	sudo bash git_download.sh ${REPOSITORY_NAME}
	
	echo -e "\nCopying JS Files to ${REPOSITORY_DIR}"
	
	if [ ! -d ${JS_DIR} ]; then
	
		mkdir -pv ${JS_DIR}
	
	fi
	
	if [ ! -d ${CSS_DIR} ]; then
	
		mkdir -pv ${CSS_DIR}
	
	fi
	
	cp -fv ${DIR_TOMCAT_JS}/*.js ${JS_DIR}
	cp -fv ${DIR_TOMCAT_CSS}/*.css ${CSS_DIR}
	
	ls -al ${JS_DIR} ${CSS_DIR}
	
	sudo bash git_remote.sh ${REPOSITORY_NAME}
	
}

REPOSITORY_NAME="lls-ws.github.io"
REPOSITORY_DIR=~/${REPOSITORY_NAME}"/jquery-lls"

JS_DIR="${REPOSITORY_DIR}/js"
CSS_DIR="${REPOSITORY_DIR}/css"
